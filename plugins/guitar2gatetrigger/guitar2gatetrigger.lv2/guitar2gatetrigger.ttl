@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .

<urn:guitarsynthplugins:Guitar2GateTrigger>
    a lv2:AnalyserPlugin ;
    doap:name "Guitar2GateTrigger" ;
    doap:description "Amplitude gate and pluck trigger from a monophonic guitar input." ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "input" ;
        lv2:name "Guitar input"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 1 ;
        lv2:symbol "threshold" ;
        lv2:name "Gate threshold" ;
        lv2:default 0.01 ;
        lv2:minimum 0.0005 ;
        lv2:maximum 0.2
    ] , [
        a lv2:OutputPort , lv2:CVPort ;
        lv2:index 2 ;
        lv2:symbol "gate" ;
        lv2:name "Gate" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.0 ;
        lv2:portProperty lv2:toggled
    ] , [
        a lv2:OutputPort , lv2:CVPort ;
        lv2:index 3 ;
        lv2:symbol "trigger" ;
        lv2:name "Trigger" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.0 ;
        lv2:portProperty lv2:toggled
    ] .
